# Copy this file to .env and fill in what you need. Never commit .env.

# Database. Defaults to data/mwg.db inside the repo; Docker uses /data/mwg.db (the ./data folder).
# DATABASE_URL=sqlite:///./data/mwg.db

# Steam. Optional Steamworks publisher Web API key: allows faster syncing (about 4 requests per
# second instead of 1). Leave empty to sync without one.
STEAM_PUBLISHER_KEY=

# Nightly sync: cron schedule and timezone.
SYNC_CRON=0 3 * * *
SYNC_TIMEZONE=America/Chicago
# Days between full crawls (full crawls are what detect deleted reviews).
FULL_SYNC_INTERVAL_DAYS=7

# Anthropic. In Claude Code cloud sessions use MWG_ANTHROPIC_API_KEY instead (same value).
ANTHROPIC_API_KEY=
MODEL_TAGGING=claude-haiku-5-5
MODEL_ANALYSIS=claude-sonnet-5-5

# PDF reports. Leave empty to use the Chromium that `playwright install chromium` downloads
# (the Docker image does this); set a path to use a browser already on the machine.
CHROMIUM_PATH=
