# Copy this file to .env and fill in what you need. Never commit .env.

# Database. Defaults to data/mwg.db inside the repo; Docker uses /data/mwg.db (the ./data folder).
# DATABASE_URL=sqlite:///./data/mwg.db

# Steam. Optional Steamworks publisher Web API key: allows faster syncing (about 4 requests per
# second instead of 1). Leave empty to sync without one.
STEAM_PUBLISHER_KEY=

# Nightly sync: cron schedule and timezone.
SYNC_CRON=0 3 * * *
SYNC_TIMEZONE=America/Chicago
# Days between full crawls (full crawls are what detect deleted reviews).
FULL_SYNC_INTERVAL_DAYS=7

# Anthropic. In Claude Code cloud sessions use MWG_ANTHROPIC_API_KEY instead (same value).
ANTHROPIC_API_KEY=
MODEL_TAGGING=claude-haiku-5-5
MODEL_ANALYSIS=claude-sonnet-5-5

# PDF reports. Leave empty to use the Chromium that `playwright install chromium` downloads
# (the Docker image does this); set a path to use a browser already on the machine.
CHROMIUM_PATH=

# Sign-in. People sign in with a Google account on ALLOWED_DOMAINS; the README explains how to get
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET. ADMIN_EMAILS are always admins (comma-separated);
# everyone else starts as a viewer. PUBLIC_URL is the address people open, e.g.
# https://insights.midwestgames.com. `make dev` turns sign-in off unless you set AUTH_MODE here.
# AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAINS=
ADMIN_EMAILS=
PUBLIC_URL=

# Nightly analysis (switched on per title in Themes setup). A nightly run over this limit, in US
# dollars per title, waits for an admin instead of starting.
NIGHTLY_ANALYSIS_MAX_USD=0.50
SUMMARY_REFRESH_DAYS=7

# Alerts (optional): a Slack incoming webhook and/or email through an SMTP server.
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAILS=
